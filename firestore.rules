rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All (Safety Net)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isDemoOrOwner(userId) {
      return isOwner(userId) || userId == 'demo-user-lausanne' || userId.matches('^demo-.*$');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Users Collection & Subcollections (Strict Tenant Isolation with Demo Sandbox Support)
    match /users/{userId} {
      // Individual user document
      allow read, write: if isDemoOrOwner(userId) && isValidId(userId);

      // Candidate Master Profile: users/{userId}/profiles/main (and all profile documents)
      match /profiles/{profileId} {
        allow read, write: if isDemoOrOwner(userId);
      }

      // User's Personal Jobs Collection & ALL nested sub-documents of 'jobs'
      match /jobs/{jobId} {
        // Direct job document
        allow read, write: if isDemoOrOwner(userId);

        // All sub-documents and nested sub-collections of 'jobs'
        match /{allJobSubdocs=**} {
          allow read, write: if isDemoOrOwner(userId);
        }
      }

      // User's Daily Reports (8h00 morning ritual)
      match /dailyReports/{reportId} {
        allow read, write: if isDemoOrOwner(userId);
      }

      // User's ORP Job Search Proofs (LACI Vaud compliance)
      match /orpEntries/{entryId} {
        allow read, write: if isDemoOrOwner(userId);
      }

      // User's Subscription Invoices & Tax Receipts
      match /invoices/{invoiceId} {
        allow read, write: if isDemoOrOwner(userId);
      }
    }

    // 3. Test Connection Document for Initial Boot Verification
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
